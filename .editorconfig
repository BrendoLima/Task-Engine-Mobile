root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,jsx,ts,tsx,json,yml,yaml,md,css,scss}]
indent_size = 2

[*.{kt,kts,java,gradle,pro}]
indent_size = 4

[*.{ps1,psm1}]
end_of_line = crlf
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
